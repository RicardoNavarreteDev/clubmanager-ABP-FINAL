<main class="auth-public-page">
  <section class="auth-split-shell">
    <section class="auth-sport-panel">
      <img src="/images/loginFinal.png" alt="Equipo de básquetbol reunido antes de un partido">
      <div class="auth-sport-overlay"></div>
      <a class="auth-panel-brand" href="/">
        <img src="/favicon.svg" alt="">
        <span>ClubManager</span>
      </a>
      <p class="auth-panel-kicker">Tu equipo. Siempre contigo</p>
      <div class="auth-sport-copy">
        <h2>Disciplina<br>hoy, mejores<br>resultados<br>mañana.</h2>
        <i aria-hidden="true"></i>
      </div>
      <ul class="auth-sports-list" aria-label="Deportes disponibles"><li>◉<span>Básquetbol</span></li><li>◌<span>Fútbol</span></li><li>◉<span>Vóleibol</span></li><li>⌁<span>Hockey</span></li><li>•••<span>Y más</span></li></ul>
    </section>
    <div class="auth-login-panel">
      <div class="auth-login-content">
        <header><h1>Accede a tu cuenta</h1><span>Bienvenido a ClubManager</span></header>

        {{#if loginError}}
          <div class="web-alert web-alert-error" role="alert" id="login-error">{{loginError}}</div>
        {{/if}}

        <form class="public-auth-form" action="/login" method="post">
          <label class="public-field auth-email-field">
            <span>Correo electrónico</span>
            <input type="email" name="email" value="{{loginForm.email}}" placeholder="tu@correo.com" required autocomplete="email">
          </label>
          <label class="public-field">
            <span>Contraseña</span>
            <input type="password" name="password" placeholder="Tu contraseña" required autocomplete="current-password">
          </label>
          <div class="auth-form-meta">
            <label><input type="checkbox" name="remember"> Recordarme</label>
            <a href="mailto:soporte@clubmanager.local">¿Olvidaste tu contraseña?</a>
          </div>
          <button type="submit" class="public-button public-button-primary auth-login-submit">Iniciar sesión</button>
        </form>
        <div class="auth-divider"><span>o</span></div>
        <button class="auth-provider" type="button"><b class="google-mark">G</b> Continuar con Google</button>
        <button class="auth-provider" type="button"><b class="apple-mark">●</b> Continuar con Apple</button>
        <p class="auth-register-note">¿No tienes una cuenta? <a href="/crear-club">Regístrate aquí</a></p>
      </div>
    </div>
  </section>
</main>
