{{!-- Este archivo muestra la lista de jugadores con su informacion principal. --}}
<header class="page-header">
  <h1>Jugadores</h1>
  <p>Listado de jugadores de {{currentClub.name}}.</p>
</header>

<section class="players-grid">
  {{#each players}}
    <article class="player-card">
      <div class="player-card-profile">
        <div class="player-card-portrait">
          <img src="{{displayAvatar}}" alt="Avatar de {{name}}" width="80" height="80" loading="lazy" decoding="async">
        </div>

        <div class="player-card-copy">
          <div class="player-card-topbar">
            <span class="player-card-role">Jugador</span>
            <span class="player-card-number">#{{number}}</span>
          </div>

          <h2>{{name}}</h2>
          <p class="player-card-position">{{position}}</p>

          <div class="player-card-inline-meta">
            <div class="player-detail-card">
              <div class="player-detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="8" r="3" />
                  <path d="M3.5 18c1.2-2.6 3.6-4.2 5.5-4.2" />
                  <path d="M14 7h6" />
                  <path d="M17 4v6" />
                </svg>
              </div>

              <div>
                <span>Categoria</span>
                <strong>{{categoryName}}</strong>
              </div>
            </div>

            <div class="player-detail-card">
              <div class="player-detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3.5" y="5" width="17" height="15" rx="2" />
                  <path d="M8 3.5V7" />
                  <path d="M16 3.5V7" />
                  <path d="M3.5 10h17" />
                </svg>
              </div>

              <div>
                <span>Edad</span>
                <strong>{{age}} anos</strong>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="player-card-divider"></div>

      <div class="player-status-grid">
        <div class="player-status-info">
          <div class="player-status-info-icon player-status-info-icon-status" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12 2 7 4v6c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-4Z" />
              <path d="m9.5 12 1.8 1.8 3.2-3.6" />
            </svg>
          </div>

          <div>
            <span>Estado actual</span>
            <strong class="player-status-text" data-tone="{{rosterStatusTone}}">{{rosterStatusLabel}}</strong>
          </div>
        </div>

        <div class="player-status-info player-status-info-team">
          <div class="player-status-info-icon player-status-info-icon-team" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21s6-4.35 6-10a6 6 0 1 0-12 0c0 5.65 6 10 6 10Z" />
              <circle cx="12" cy="11" r="2" />
            </svg>
          </div>

          <div>
            <span>Equipo</span>
            <strong>{{teamName}}</strong>
          </div>
        </div>
      </div>

      {{#if ../showManagementLinks}}
        <div class="player-management-actions">
          <button
            type="button"
            class="player-action-button player-action-button-secondary"
            data-player-edit-open
            data-modal-open="edit-player-modal"
            data-player-id="{{id}}"
            data-player-name="{{name}}"
            data-player-position="{{position}}"
            data-player-number="{{number}}"
            data-player-bio="{{bio}}"
            data-player-location="{{location}}"
            data-player-birth-date="{{birthDate}}"
          >
            <span class="player-action-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="m4 20 4.5-1 9-9a2.1 2.1 0 0 0-3-3l-9 9L4 20Z" />
                <path d="m13.5 6.5 4 4" />
              </svg>
            </span>
            <span>Editar jugador</span>
          </button>

          <button
            type="button"
            class="player-action-button player-action-button-primary"
            data-player-status-open
            data-modal-open="player-status-modal"
            data-player-id="{{id}}"
            data-player-name="{{name}}"
            data-player-status="{{rosterStatus}}"
          >
            <span class="player-action-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 11a8 8 0 0 0-14.9-4" />
                <path d="M4 4v4h4" />
                <path d="M4 13a8 8 0 0 0 14.9 4" />
                <path d="M20 20v-4h-4" />
              </svg>
            </span>
            <span>Cambiar estado</span>
          </button>
        </div>
      {{/if}}
    </article>
  {{else}}
    <article class="empty-state-card collection-empty-state">
      <h2>El plantel aun esta vacio</h2>
      <p>Los jugadores apareceran aqui cuando acepten sus invitaciones.</p>
      {{#if showManagementLinks}}<a class="public-button public-button-primary" href="/gestion/invitaciones">Invitar jugador</a>{{/if}}
    </article>
  {{/each}}
</section>

{{#if showManagementLinks}}
  <div class="modal-backdrop" data-modal="edit-player-modal" data-modal-archive hidden>
    <div class="modal-panel settings-modal-panel" role="dialog" aria-modal="true" aria-labelledby="edit-player-modal-title">
      <div class="modal-header" data-modal-archive-item>
        <button type="button" class="modal-close-button" data-modal-close="edit-player-modal" aria-label="Cerrar diálogo Editar jugador">×</button>
        <h2 id="edit-player-modal-title">Editar jugador</h2>
        <button type="submit" class="modal-save-button" form="edit-player-form">Guardar</button>
      </div>

      <form id="edit-player-form" class="profile-modal-form" data-modal-archive-item data-player-edit-form novalidate>
        <p class="form-status-message" data-form-status aria-live="polite"></p>
        <input type="hidden" name="playerId">

        <label class="form-field">
          <span>Nombre</span>
          <input type="text" name="name" required>
          <small class="form-error-text" data-field-error="name"></small>
        </label>

        <label class="form-field">
          <span>Posicion</span>
          <input type="text" name="position">
          <small class="form-error-text" data-field-error="position"></small>
        </label>

        <label class="form-field">
          <span>Numero</span>
          <input type="number" name="number" min="0">
          <small class="form-error-text" data-field-error="number"></small>
        </label>

        <label class="form-field">
          <span>Bio</span>
          <textarea name="bio"></textarea>
          <small class="form-error-text" data-field-error="bio"></small>
        </label>

        <label class="form-field">
          <span>Ubicacion</span>
          <input type="text" name="location">
          <small class="form-error-text" data-field-error="location"></small>
        </label>

        <label class="form-field">
          <span>Fecha de nacimiento</span>
          <input type="date" name="birthDate">
          <small class="form-error-text" data-field-error="birthDate"></small>
        </label>
      </form>
    </div>
  </div>

  <div class="modal-backdrop" data-modal="player-status-modal" data-modal-archive hidden>
    <div class="modal-panel settings-modal-panel" role="dialog" aria-modal="true" aria-labelledby="player-status-modal-title">
      <div class="modal-header" data-modal-archive-item>
        <button type="button" class="modal-close-button" data-modal-close="player-status-modal" aria-label="Cerrar diálogo Cambiar estado del jugador">×</button>
        <h2 id="player-status-modal-title">Cambiar estado del jugador</h2>
        <button type="submit" class="modal-save-button" form="player-status-form">Guardar</button>
      </div>

      <form id="player-status-form" class="profile-modal-form" data-modal-archive-item data-player-status-form novalidate>
        <p class="form-status-message" data-form-status aria-live="polite"></p>
        <input type="hidden" name="playerId">

        <label class="form-field">
          <span>Jugador</span>
          <input type="text" name="playerName" readonly>
        </label>

        <label class="form-field">
          <span>Nuevo estado</span>
          <select name="rosterStatus" required>
            <option value="invited">Invitado</option>
            <option value="active">Activo</option>
            {{#if isAdmin}}
              <option value="inactive">Inactivo</option>
            {{/if}}
          </select>
          <small class="form-help-text">Solo admin puede dejar un jugador en estado inactive.</small>
          <small class="form-error-text" data-field-error="rosterStatus"></small>
        </label>
      </form>
    </div>
  </div>
{{/if}}

<nav class="players-pagination-card" aria-label="Paginación de jugadores">
  <div class="players-pagination-controls">
    {{#if pagination.hasPreviousPage}}
      <a class="pagination-link" href="{{pagination.previousPageHref}}" rel="prev">Anterior</a>
    {{else}}
      <span class="pagination-link pagination-link-disabled" aria-disabled="true">Anterior</span>
    {{/if}}

    <div class="pagination-pages">
      {{#each pagination.pages}}
        {{#if isCurrent}}
          <a class="pagination-page active" href="{{href}}" aria-current="page" aria-label="Página {{number}} de jugadores">{{number}}</a>
        {{else}}
          <a class="pagination-page" href="{{href}}" aria-label="Página {{number}} de jugadores">{{number}}</a>
        {{/if}}
      {{/each}}
    </div>

    {{#if pagination.hasNextPage}}
      <a class="pagination-link" href="{{pagination.nextPageHref}}" rel="next">Siguiente</a>
    {{else}}
      <span class="pagination-link pagination-link-disabled" aria-disabled="true">Siguiente</span>
    {{/if}}
  </div>
</nav>
