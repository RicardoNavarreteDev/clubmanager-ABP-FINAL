{{!-- Este archivo muestra la pagina de eventos con bloques de partidos jugados, proximos partidos y entrenamientos. --}}
<header class="page-header">
  <h1>Eventos</h1>
  <p>Partidos y entrenamientos del Club Prueba.</p>
</header>

<section class="events-filter-bar">
  {{#each eventFilters}}
    <button type="button" class="event-filter-chip {{#if isActive}}active{{/if}}">{{label}}</button>
  {{/each}}
</section>

<section class="events-block-section">
  <div class="events-section-heading">
    <div>
      <p class="events-section-kicker">Partidos</p>
      <h2>Partidos jugados</h2>
    </div>
    <a href="/eventos" class="events-inline-link">Ver todos</a>
  </div>

  <div class="events-showcase-grid">
    {{#each playedMatches}}
      <article
        class="event-showcase-card event-showcase-card-played event-showcase-card-{{resultTone}}"
        data-event-modal-trigger
        data-event-type="Partido jugado"
        data-event-title="{{opponent}}"
        data-event-tag="Finalizado"
        data-event-tag-tone="{{resultTone}}"
        data-event-subtitle="{{championshipName}}"
        data-event-date="{{date}}"
        data-event-time="{{time}}"
        data-event-location="{{location}}"
        data-event-condition="{{condition}}"
        data-event-result="{{resultLabel}} · {{resultSummary}}"
        tabindex="0"
        role="button"
        aria-label="Ver detalle de partido contra {{opponent}}"
      >
        <div class="event-showcase-topbar">
          <p class="event-tag event-tag-{{resultTone}}">{{resultLabel}}</p>
          <p class="event-showcase-date">{{compactDate}}</p>
        </div>

        <div class="event-scoreboard-grid">
          <div class="event-team-block">
            <div class="event-team-badge event-team-badge-home">CP</div>
            <h3>Club Prueba</h3>
          </div>

          <div class="event-score-block">
            <strong>{{resultSummary}}</strong>
            <p>{{championshipName}}</p>
          </div>

          <div class="event-team-block">
            <div class="event-team-badge event-team-badge-away">{{opponentShortLabel}}</div>
            <h3>{{opponent}}</h3>
          </div>
        </div>

        <div class="event-showcase-footer">
          <div class="event-showcase-meta-row">
            <p>{{time}}</p>
            <p>{{location}}</p>
          </div>
          <span class="event-showcase-link">Ver detalle</span>
        </div>
      </article>
    {{/each}}
  </div>
</section>

<section class="events-block-section">
  <div class="events-section-heading">
    <div>
      <p class="events-section-kicker">Agenda</p>
      <h2>Proximos partidos</h2>
    </div>
    <a href="/eventos" class="events-inline-link">Ver todos</a>
  </div>

  <div class="events-upcoming-grid">
    {{#each pendingMatches}}
      <article
        class="event-upcoming-card"
        data-event-modal-trigger
        data-event-type="Proximo partido"
        data-event-title="{{opponent}}"
        data-event-tag="Proximo"
        data-event-tag-tone="neutral"
        data-event-subtitle="{{championshipName}}"
        data-event-date="{{date}}"
        data-event-time="{{time}}"
        data-event-location="{{location}}"
        data-event-condition="{{condition}}"
        data-event-result="Pendiente"
        tabindex="0"
        role="button"
        aria-label="Ver detalle del proximo partido contra {{opponent}}"
      >
        <div class="event-upcoming-topbar">
          <p class="event-tag event-tag-neutral">Proximo</p>
          <p class="event-showcase-date">{{compactDate}}</p>
        </div>

        <div class="event-upcoming-duel">
          <div class="event-team-block">
            <div class="event-team-badge {{#if isLocal}}event-team-badge-home{{else}}event-team-badge-away{{/if}}">{{homeTeamShortLabel}}</div>
            <h3>{{homeTeamName}}</h3>
          </div>

          <div class="event-upcoming-vs">VS</div>

          <div class="event-team-block">
            <div class="event-team-badge {{#if isLocal}}event-team-badge-away{{else}}event-team-badge-home{{/if}}">{{awayTeamShortLabel}}</div>
            <h3>{{awayTeamName}}</h3>
          </div>
        </div>

        <p class="event-upcoming-subtitle">{{championshipName}} · {{conditionLabel}}</p>

        <div class="event-upcoming-footer">
          <div class="event-upcoming-meta-list">
            <p class="event-upcoming-meta-item">
              <span class="event-upcoming-meta-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="8.5" />
                  <path d="M12 7.5V12l3 1.8" />
                </svg>
              </span>
              <span>{{time}}</span>
            </p>

            <p class="event-upcoming-meta-item">
              <span class="event-upcoming-meta-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20s6-5.33 6-10a6 6 0 1 0-12 0c0 4.67 6 10 6 10Z" />
                  <circle cx="12" cy="10" r="2.5" />
                </svg>
              </span>
              <span>{{location}}</span>
            </p>
          </div>

          <span class="event-showcase-link">Ver detalle</span>
        </div>
      </article>
    {{/each}}
  </div>
</section>

<section class="events-block-section">
  <div class="events-section-heading">
    <div>
      <p class="events-section-kicker">Entrenamientos</p>
      <h2>Proximos entrenamientos</h2>
    </div>
    <a href="/eventos" class="events-inline-link">Ver todos</a>
  </div>

  <div class="events-training-cards-grid">
    {{#each trainings}}
      <article
        class="events-training-card"
        data-event-modal-trigger
        data-event-type="Entrenamiento"
        data-event-title="{{trainingType}}"
        data-event-tag="Entrenamiento"
        data-event-tag-tone="neutral"
        data-event-subtitle="{{categoryName}}"
        data-event-date="{{date}}"
        data-event-time="{{time}}"
        data-event-location="{{location}}"
        data-event-condition="Planificado"
        data-event-result="Sesion programada"
        tabindex="0"
        role="button"
        aria-label="Ver detalle del entrenamiento {{trainingType}}"
        data-tone="{{accentTone}}"
        >
        <div class="events-training-card-topbar">
          <div class="events-training-daybox" data-tone="{{accentTone}}">
            <strong>{{dayNumber}}</strong>
            <span>{{monthLabel}}</span>
            <small>{{weekdayLabel}}</small>
          </div>

          <div class="events-training-card-copy">
            <h3>{{categoryName}}</h3>
            <p class="events-training-card-type">{{trainingType}}</p>
            <p>{{time}}</p>
            <p>{{location}}</p>
          </div>

          <span class="events-training-card-mark" data-tone="{{accentTone}}" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 11.5h10" />
              <path d="M9 8.5 7 11.5l2 3" />
              <path d="M15 8.5l2 3-2 3" />
              <path d="M4.5 18.5c1.2-2 3.2-3 5-3" />
              <path d="M19.5 18.5c-1.2-2-3.2-3-5-3" />
            </svg>
          </span>
        </div>

        <div class="events-training-card-footer">
          <p>{{attendanceLabel}}</p>
          <span class="events-training-card-arrow">→</span>
        </div>
      </article>
    {{/each}}
  </div>
</section>

<div class="modal-backdrop" data-modal="event-detail-modal" data-modal-archive hidden>
  <div class="modal-panel event-detail-modal-panel" role="dialog" aria-modal="true" aria-labelledby="event-detail-title">
    <div class="modal-header" data-modal-archive-item>
      <button type="button" class="modal-close-button" data-modal-close="event-detail-modal">×</button>
      <h2 id="event-detail-title">Detalle del evento</h2>
      <button type="button" class="modal-save-button event-detail-close-button" data-modal-close="event-detail-modal">Cerrar</button>
    </div>

    <div class="event-detail-body" data-modal-archive-item>
      <div class="event-detail-hero">
        <p class="event-tag" data-event-detail-tag></p>
        <p class="event-detail-type" data-event-detail-type></p>
        <h3 data-event-detail-heading></h3>
        <p class="event-detail-subtitle" data-event-detail-subtitle></p>
      </div>

      <div class="event-detail-grid">
        <p><span>Fecha</span><strong data-event-detail-date></strong></p>
        <p><span>Hora</span><strong data-event-detail-time></strong></p>
        <p><span>Lugar</span><strong data-event-detail-location></strong></p>
        <p><span>Condicion</span><strong data-event-detail-condition></strong></p>
      </div>

      <div class="event-detail-result-card">
        <span>Estado actual</span>
        <p data-event-detail-result></p>
      </div>
    </div>
  </div>
</div>
