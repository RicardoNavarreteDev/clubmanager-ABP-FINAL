{{!-- Este archivo renderiza la pagina 404 cuando ninguna ruta coincide. --}}
<section style="min-height: 60vh; display: grid; place-items: center; padding: 2rem;">
  <div style="max-width: 36rem; text-align: center; padding: 2rem; border-radius: 1rem; background: rgba(255,255,255,0.08);">
    <p style="margin: 0 0 0.5rem; font-size: 0.9rem; letter-spacing: 0.12em; text-transform: uppercase;">
      ClubManager
    </p>

    <h1 style="margin: 0; font-size: 3rem;">
      Error 404
    </h1>

    <p style="margin: 1rem 0 1.5rem; line-height: 1.6;">
      La pagina que intentaste abrir no existe, fue movida o la URL es incorrecta.
    </p>

    <a
      href="/"
      style="display: inline-block; padding: 0.85rem 1.2rem; border-radius: 999px; text-decoration: none;"
      aria-label="Volver al inicio de ClubManager"
    >
      Volver al inicio de ClubManager
    </a>
  </div>
</section>
