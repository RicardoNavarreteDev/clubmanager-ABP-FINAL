<section class="club-home-hero">
  <img src="/images/sports-login.svg" alt="Cancha deportiva de {{currentClub.sport}}">
  <div class="club-home-hero-shade"></div>
  <div class="club-home-hero-copy">
    <p>{{currentClub.name}}</p>
    <h1>Mas que un equipo,<br>una <span>familia</span></h1>
    <strong>{{#if currentClub.description}}{{currentClub.description}}{{else}}Disciplina, juego en equipo y buena energia dentro y fuera de la cancha.{{/if}}</strong>
  </div>
</section>

<section class="team-feed-composer" id="inicio-comunidad" data-feed-enabled="{{feedPersistenceEnabled}}">
  <form data-feed-composer enctype="multipart/form-data">
    <div class="team-feed-composer-main">
      <img src="{{currentViewer.avatar}}" alt="Perfil de {{currentViewer.name}}">
      <textarea name="content" rows="1" placeholder="Que quieres compartir con el equipo?" data-feed-content></textarea>
    </div>

    <input type="hidden" name="type" value="text" data-feed-type-input>
    <input type="file" name="image" accept="image/jpeg,image/png,image/webp" data-feed-image-input hidden>

    <div class="feed-composer-extra" data-feed-photo-panel hidden>
      <span data-feed-photo-name>Selecciona una imagen para publicar.</span>
    </div>
    <div class="feed-composer-extra feed-poll-fields" data-feed-poll-panel hidden>
      <input type="text" name="pollQuestion" placeholder="Pregunta de la encuesta">
      <input type="text" data-poll-option placeholder="Opcion 1">
      <input type="text" data-poll-option placeholder="Opcion 2">
      <button type="button" data-add-poll-option>Agregar opcion</button>
    </div>
    <div class="feed-composer-extra feed-event-fields" data-feed-event-panel hidden>
      <input type="text" name="eventTitle" placeholder="Nombre del evento">
      <input type="datetime-local" name="eventStartAt">
      <input type="text" name="eventLocation" placeholder="Lugar">
    </div>

    <div class="team-feed-composer-toolbar">
      <div class="team-feed-tools">
        <button type="button" data-feed-type="photo"><span aria-hidden="true">&#9638;</span> Foto</button>
        <button type="button" data-feed-type="poll"><span aria-hidden="true">&#9636;</span> Encuesta</button>
        <button type="button" data-feed-type="event"><span aria-hidden="true">&#9633;</span> Evento</button>
        {{#if showManagementLinks}}<button type="button" data-feed-type="announcement"><span aria-hidden="true">!</span> Aviso</button>{{/if}}
      </div>
      <button type="submit" class="team-feed-publish">Publicar</button>
    </div>
    <p class="feed-form-status" data-feed-status aria-live="polite"></p>
  </form>
</section>

{{#if hasNoActivity}}
  <section class="home-first-steps">
    <div><p class="public-eyebrow">Primeros pasos</p><h2>Tu club ya esta listo para comenzar.</h2></div>
    <div class="home-first-step-links">
      <a href="/gestion/categorias"><span>01</span> Crear otra categoria</a>
      <a href="/gestion/invitaciones"><span>02</span> Invitar al equipo</a>
      <a href="/campeonatos/nuevo"><span>03</span> Crear campeonato</a>
      <a href="/gestion/partidos/nuevo"><span>04</span> Programar partido</a>
    </div>
  </section>
{{/if}}

<section class="team-feed-list" aria-label="Actividad del club">
  {{#each posts}}
    <article class="team-feed-post" data-feed-post="{{id}}">
      <header class="team-feed-post-header">
        <img src="{{authorAvatar}}" alt="Perfil de {{authorName}}">
        <div><h2>{{authorName}} <span>{{authorRole}}</span></h2><p>{{displayDate}}</p></div>
        <button type="button" aria-label="Opciones de publicacion">...</button>
      </header>

      {{#if isAnnouncement}}<p class="team-feed-announcement-label">Aviso del club</p>{{/if}}
      {{#if content}}<p class="team-feed-post-content">{{content}}</p>{{/if}}
      {{#if imageUrl}}<img class="team-feed-post-image" src="{{imageUrl}}" alt="Imagen compartida por {{authorName}}">{{/if}}

      {{#if isEvent}}
        <div class="team-feed-event-card"><span>EVENTO</span><h3>{{event.title}}</h3><p>{{eventDate}}{{#if event.location}} · {{event.location}}{{/if}}</p></div>
      {{/if}}

      {{#if isPoll}}
        <form class="team-feed-poll" data-feed-poll-form data-post-id="{{id}}">
          <h3>{{poll.question}}</h3>
          {{#each poll.options}}
            <label><input type="radio" name="optionId" value="{{id}}" {{#if selectedByCurrentUser}}checked{{/if}}><span>{{label}}</span><strong>{{percentage}}%</strong><i style="width: {{percentage}}%"></i></label>
          {{/each}}
          <button type="submit">Votar · {{poll.votesCount}} votos</button>
        </form>
      {{/if}}

      <div class="team-feed-actions">
        <button type="button" class="team-feed-like {{#if likedByCurrentUser}}active{{/if}}" data-feed-like data-post-id="{{id}}"><span aria-hidden="true">&#9829;</span> <b data-like-count>{{likesCount}}</b></button>
        <button type="button" data-comments-toggle><span aria-hidden="true">&#9635;</span> {{commentsCount}}</button>
      </div>

      <div class="team-feed-comments" data-comments-panel>
        {{#each comments}}
          <article class="team-feed-comment">
            <img src="{{authorAvatar}}" alt="Perfil de {{authorName}}">
            <div><strong>{{authorName}}</strong><span>{{displayDate}}</span><p>{{content}}</p><button type="button" data-reply-toggle>Responder</button></div>
            <form data-feed-reply-form data-post-id="{{../id}}" data-comment-id="{{id}}" hidden><input name="content" placeholder="Escribe una respuesta" required><button>Enviar</button></form>
            {{#each replies}}
              <article class="team-feed-comment team-feed-reply"><img src="{{authorAvatar}}" alt=""><div><strong>{{authorName}}</strong><span>{{displayDate}}</span><p>{{content}}</p></div></article>
            {{/each}}
          </article>
        {{/each}}
        {{#if ../feedPersistenceEnabled}}
          <form class="team-feed-comment-form" data-feed-comment-form data-post-id="{{id}}"><input name="content" placeholder="Escribe un comentario..." required><button>Enviar</button></form>
        {{/if}}
      </div>
    </article>
  {{else}}
    <article class="empty-state-card collection-empty-state"><h3>Aun no hay publicaciones</h3><p>Comparte arriba el primer mensaje de {{currentClub.name}}.</p></article>
  {{/each}}
</section>
