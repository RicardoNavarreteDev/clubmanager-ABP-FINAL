{{!-- Este archivo es el layout principal compartido por todas las vistas. --}}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if pageTitle}}{{pageTitle}} | ClubManager{{else}}ClubManager – Gestión deportiva{{/if}}</title>
    <meta name="description" content="Panel privado ClubManager">
    <meta name="robots" content="noindex,nofollow">
    <meta name="theme-color" content="#0f0d1f">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/css/output.css">
</head>
<body
    class="dashboard-page"
    data-is-authenticated="{{isAuthenticated}}"
    data-is-admin="{{isAdmin}}"
    data-is-coach="{{isCoach}}"
    data-is-player="{{isPlayer}}"
    data-auth-token="{{authToken}}"
>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <button
        type="button"
        class="mobile-nav-toggle"
        data-mobile-nav-toggle
        aria-expanded="false"
        aria-controls="sidebar-navigation"
        aria-label="Abrir menu de navegacion"
    >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
    </button>

    <div class="mobile-nav-backdrop" data-mobile-nav-backdrop hidden></div>

    <div class="app-shell">
        <aside class="sidebar" id="sidebar-navigation" data-mobile-nav-panel data-sidebar aria-label="Navegación principal y cuenta">
            <div class="brand-block">
                <span class="sidebar-brand-mark">
                    {{#if currentClub.logo}}
                        <img src="{{currentClub.logo}}" alt="Logo de {{currentClub.name}}" width="48" height="48" loading="lazy" decoding="async">
                    {{else}}
                        {{clubInitials}}
                    {{/if}}
                </span>
                <div class="sidebar-brand-copy">
                    <p class="brand-kicker">{{currentClub.sport}}</p>
                    <p class="brand-title">{{currentClub.name}}</p>
                </div>
            </div>
            {{#if isAuthenticated}}
              <details class="club-switcher">
                <summary>Cambiar club</summary>
                <div class="club-switcher-menu">
                  {{#each availableClubs}}
                    <form action="/clubs/{{id}}/activar" method="post"><button type="submit">{{name}} <small>{{role}}</small></button></form>
                  {{/each}}
                  <a href="/?modal=create-club">Crear otro club</a>
                </div>
              </details>
            {{/if}}

            <button type="button" class="sidebar-collapse-button" data-sidebar-collapse aria-expanded="true" aria-label="Contraer navegacion">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m14 7-5 5 5 5" /></svg>
            </button>

            <nav class="sidebar-nav" aria-label="Secciones del club">
                <a class="nav-link {{#if isHome}}active{{/if}}" href="/dashboard" data-tooltip="Inicio">
                    <span class="nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 10.5 12 3l9 7.5" />
                            <path d="M5.5 9.5V21h13V9.5" />
                        </svg>
                    </span>
                    <span>Inicio</span>
                </a>
                <a class="nav-link {{#if isPlayers}}active{{/if}}" href="/jugadores" data-tooltip="Jugadores">
                    <span class="nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="7.5" r="3.5" />
                            <path d="M5 20c1.5-3.5 5-5.5 7-5.5s5.5 2 7 5.5" />
                        </svg>
                    </span>
                    <span>Jugadores</span>
                </a>
                <a class="nav-link {{#if isEvents}}active{{/if}}" href="/eventos" data-tooltip="Eventos">
                    <span class="nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3.5" y="5" width="17" height="15" rx="2" />
                            <path d="M8 3.5V7" />
                            <path d="M16 3.5V7" />
                            <path d="M3.5 10h17" />
                        </svg>
                    </span>
                    <span>Eventos</span>
                </a>
                <a class="nav-link {{#if isChampionships}}active{{/if}}" href="/campeonatos" data-tooltip="Campeonatos">
                    <span class="nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M8 4h8v3a4 4 0 0 1-8 0Z" />
                            <path d="M9.5 13h5" />
                            <path d="M12 10v9" />
                            <path d="M7.5 22h9" />
                            <path d="M8 5H5.5a2 2 0 0 0 0 4H8" />
                            <path d="M16 5h2.5a2 2 0 0 1 0 4H16" />
                        </svg>
                    </span>
                    <span>Campeonatos</span>
                </a>
                <a class="nav-link {{#if isProfile}}active{{/if}}" href="/perfil" data-tooltip="Perfil">
                    <span class="nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="8" r="3.5" />
                            <path d="M5 20c1.5-3.5 5-5.5 7-5.5s5.5 2 7 5.5" />
                        </svg>
                    </span>
                    <span>Perfil</span>
                </a>

                {{#if showManagementLinks}}
                    <div class="nav-section-label">Gestion</div>

                    <a class="nav-link" href="/campeonatos/nuevo" data-tooltip="Crear campeonato">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 5v14" />
                                <path d="M5 12h14" />
                            </svg>
                        </span>
                        <span>Crear campeonato</span>
                    </a>

                    <a class="nav-link {{#if isCategories}}active{{/if}}" href="/gestion/categorias" data-tooltip="Categorias">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 7h16M7 4v6M4 17h16M16 14v6" />
                            </svg>
                        </span>
                        <span>Categorias</span>
                    </a>

                    <a class="nav-link {{#if isInvitations}}active{{/if}}" href="/gestion/invitaciones" data-tooltip="Invitaciones">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 5v14" />
                                <path d="M5 12h14" />
                                <path d="M18 7h.01" />
                            </svg>
                        </span>
                        <span>Invitaciones</span>
                    </a>

                    <a class="nav-link {{#if isMatchManagement}}active{{/if}}" href="/gestion/partidos/nuevo" data-tooltip="Crear partido">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 5v14" />
                                <path d="M5 12h14" />
                                <rect x="4" y="4" width="16" height="16" rx="2" />
                            </svg>
                        </span>
                        <span>Crear partido</span>
                    </a>
                {{/if}}
            </nav>

            {{#if isAuthenticated}}
                <details class="sidebar-account">
                    <summary class="sidebar-profile">
                        <img src="{{currentViewer.avatar}}" alt="Perfil de {{currentViewer.name}}" width="40" height="40" loading="lazy" decoding="async">
                        <div>
                            <p class="profile-name">{{currentViewer.name}}</p>
                            <p class="profile-role-label">{{currentViewer.roleLabel}}</p>
                        </div>
                        <span class="profile-menu">...</span>
                    </summary>

                    <div class="sidebar-account-menu">
                        <form action="/logout" method="post">
                            <button type="submit">Cerrar sesion {{currentViewer.username}}</button>
                        </form>
                    </div>
                </details>
            {{else}}
                <div class="sidebar-account sidebar-account-guest">
                    <div class="sidebar-profile">
                        <img src="{{currentViewer.avatar}}" alt="Perfil de {{currentViewer.name}}" width="40" height="40" loading="lazy" decoding="async">
                        <div>
                            <p class="profile-name">{{currentViewer.name}}</p>
                            <p class="profile-role-label">Inicia sesion para gestionar tu cuenta</p>
                        </div>
                    </div>

                    <div class="sidebar-account-menu sidebar-account-menu-static">
                        <a class="home-composer-button home-composer-button-primary" href="/login">Iniciar sesion</a>
                    </div>
                </div>
            {{/if}}
        </aside>

        <main id="main-content" class="content-column" tabindex="-1">
            {{#if nextUpcomingMatch}}
                <section class="mobile-next-match-card">
                    <div class="mobile-next-match-topbar">
                        <p class="mobile-next-match-kicker">Proximo partido</p>
                        <p class="mobile-next-match-location">{{nextUpcomingMatch.location}}</p>
                    </div>

                    <div class="mobile-next-match-duel">
                        <article class="mobile-team-card">
                            <div class="mobile-team-badge mobile-team-badge-home">{{clubInitials}}</div>
                            <h2>{{currentClub.name}}</h2>
                            <p>{{nextUpcomingMatch.condition}}</p>
                        </article>

                        <div class="mobile-next-match-center">
                            <p class="mobile-next-match-date">{{nextUpcomingMatch.date}}</p>
                            <strong>{{nextUpcomingMatch.time}}</strong>
                            <span>VS</span>
                        </div>

                        <article class="mobile-team-card">
                            <div class="mobile-team-badge mobile-team-badge-away">VS</div>
                            <h2>{{nextUpcomingMatch.opponent}}</h2>
                            <p>Rival</p>
                        </article>
                    </div>
                </section>
            {{/if}}
            {{{body}}}
        </main>

        <aside class="aside-column" aria-label="Próximos eventos">
            <section class="aside-card">
                <h2>Proximos partidos</h2>

                {{#each upcomingMatches}}
                    {{#if @first}}
                        <article class="aside-featured-card">
                            <div class="aside-featured-surface">
                                <div class="aside-featured-topbar">
                                    <p class="aside-featured-kicker">Proximo partido</p>
                                    <p class="aside-featured-meta">{{date}}</p>
                                </div>

                                <div class="aside-featured-duel">
                                    <div class="aside-team-block">
                                        <div class="aside-team-badge aside-team-badge-home">{{clubInitials}}</div>
                                        <h3>{{currentClub.name}}</h3>
                                        <p>{{condition}}</p>
                                    </div>

                                    <div class="aside-featured-center">
                                        <span>VS</span>
                                        <strong>{{time}}</strong>
                                    </div>

                                    <div class="aside-team-block">
                                        <div class="aside-team-badge aside-team-badge-away">GR</div>
                                        <h3>{{opponent}}</h3>
                                        <p>Rival</p>
                                    </div>
                                </div>

                                <p class="aside-featured-location">{{location}}</p>
                            </div>

                            <a class="aside-link aside-link-primary" href="/eventos" aria-label="Ver partido en eventos">Ver partido</a>
                        </article>

                    {{else}}
                        <article class="aside-line-item">
                            <div class="aside-line-item-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3.5" y="5" width="17" height="15" rx="2" />
                                    <path d="M8 3.5V7" />
                                    <path d="M16 3.5V7" />
                                    <path d="M3.5 10h17" />
                                </svg>
                            </div>

                            <div class="aside-line-item-copy">
                                <p class="aside-line-item-date">{{date}}</p>
                                <strong>{{opponent}}</strong>
                            </div>

                            <p class="aside-line-item-time">{{time}}</p>
                        </article>
                    {{/if}}
                {{/each}}

                <a class="aside-link aside-link-muted" href="/eventos" aria-label="Ver calendario de eventos">Ver calendario</a>
            </section>

            <section class="aside-card">
                <h2>Proximos entrenamientos</h2>

                {{#each upcomingTrainings}}
                    <article class="aside-training-item" data-tone="{{trainingAccentTone}}">
                        <div class="aside-training-accent"></div>
                        <div class="aside-training-badge" data-tone="{{trainingAccentTone}}">{{trainingIconLabel}}</div>
                        <div class="aside-training-copy">
                            <div class="aside-training-topbar">
                                <strong>{{categoryName}}</strong>
                                <span>{{time}}</span>
                            </div>
                            <p class="aside-training-location">{{location}}</p>
                            <p class="aside-training-date" data-tone="{{trainingAccentTone}}">{{date}}</p>
                        </div>
                    </article>
                {{/each}}

                <a class="aside-link aside-link-muted" href="/eventos" aria-label="Ver todos los entrenamientos">Ver todos</a>
            </section>
        </aside>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/gsap.min.js" defer crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/Flip.min.js" defer crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/CustomEase.min.js" defer crossorigin="anonymous"></script>
    <script src="/js/modals.js" defer></script>
    <script src="/js/navigation.js" defer></script>
    <script src="/js/app.js" defer></script>
    <script src="/js/feed.js" defer></script>
</body>
</html>
